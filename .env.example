# Copy to .env and fill in real values. Never commit .env.

# Postgres connection used at runtime by Prisma (packages/database) and the web app.
# Locally this is just your local Postgres. In serverless deployments (Vercel)
# this MUST be a pooled connection string (e.g. Neon's pooled endpoint,
# Supabase port 6543) — see "Deploying to Vercel" in README.md.
DATABASE_URL="postgresql://amplifyworld:amplifyworld@localhost:5432/amplifyworld_link"

# Direct/unpooled connection, used only by `prisma migrate`. Locally this can
# be the same value as DATABASE_URL. In production, use the non-pooled
# connection string from your Postgres provider.
DIRECT_URL="postgresql://amplifyworld:amplifyworld@localhost:5432/amplifyworld_link"

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Optional — auth.ts sets trustHost: true, so Auth.js infers this from the
# request in deployed environments (including Vercel preview URLs). Only set
# it locally, or in production if you want to pin it explicitly.
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used in generated links (e.g. shared page URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Verifies inbound webhooks from fanwallet/hedera-api/stake. Generate with: openssl rand -hex 32
INTEGRATION_WEBHOOK_SECRET="replace-me"

# --- Onboarding wizard AI assistance (optional) ---
# Without this, the wizard falls back to deterministic template-only drafts
# instead of erroring — see apps/web/src/server/services/ai-assistant.ts.
# ANTHROPIC_API_KEY=

# --- Spotify: sign-in AND onboarding wizard profile import (one app, two uses) ---
# The same Spotify Developer app serves both apps/web/src/server/auth.ts's
# sign-in provider (OAuth login — this doubles as an artist's "connect your
# socials" moment) and the wizard's client-credentials artist search in
# server/services/profile-import. Without these, sign-in shows "no auth
# provider configured" and "search Spotify" in the wizard returns no results.
# In the Spotify Developer Dashboard, add this exact redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/callback/spotify
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Other optional OAuth providers (add to apps/web/src/server/auth.ts as needed) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Artist Momentum Index daily ETL (apps/web/src/app/api/cron/momentum) ---
# Authenticates Vercel Cron's call to this route (Authorization: Bearer <value>).
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# --- Viberate Music Data API (cross-platform artist data + momentum signal) ---
# Not yet usable — requires the Viberate Music Data API product (a separate
# subscription from Premium Analytics). Until then the app runs entirely on
# the no-op fallback in server/services/artist-intelligence — see that file.
# VIBERATE_API_KEY=
