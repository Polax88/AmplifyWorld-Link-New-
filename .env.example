# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string used by Prisma (packages/database) and the web app.
DATABASE_URL="postgresql://amplifyworld:amplifyworld@localhost:5432/amplifyworld_link"

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used in generated links (e.g. shared page URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Verifies inbound webhooks from fanwallet/hedera-api/stake. Generate with: openssl rand -hex 32
INTEGRATION_WEBHOOK_SECRET="replace-me"

# --- Optional OAuth providers (add to apps/web/src/server/auth.ts as needed) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
