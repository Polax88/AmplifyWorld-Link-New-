// AmplifyWorld Link data model.
//
// Design notes for future maintainers:
// - `Block` is intentionally polymorphic (`type` + freeform `config` Json).
//   New block kinds (embeds, token-gates, etc.) are added in the
//   `@amplifyworld/core` block registry and DO NOT require a migration here.
// - `FeatureFlag` supports progressive rollout so new features can ship dark
//   and be turned on per-environment/per-percentage without a redeploy.
// - `IntegrationConnection` + `WebhookSubscription` are the seams the rest of
//   the AmplifyWorld ecosystem (fanwallet, hedera-api, stake) plugs into.
//   This app never imports those services directly — it only emits domain
//   events and stores connection metadata, keeping this codebase decoupled
//   and independently deployable.

generator client {
  provider      = "prisma-client-js"
  // No custom `output` — this generates into the default, node_modules-
  // integrated location (@prisma/client). A custom output path outside the
  // app's own directory (this is a pnpm monorepo; the schema lives in
  // packages/database) is the single most commonly-documented cause of
  // "Query Engine not found" on Vercel: Next.js's file tracer has native,
  // well-tested support for the default location, but only heuristic
  // support for arbitrary custom output paths, which has proven unreliable
  // here even with binaryTargets set correctly and explicit tracing hints.
  //
  // "native" covers local dev/CI on whatever OS runs `prisma generate`.
  // "rhel-openssl-3.0.x" is Vercel's Node.js serverless (AWS Lambda) runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon/PgBouncer) — used at runtime by serverless
  // functions, which would otherwise exhaust the Postgres connection limit.
  url       = env("DATABASE_URL")
  // Direct/unpooled connection, used only by `prisma migrate` — schema
  // migrations need a session-mode connection, not a transaction pooler.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth-compatible)
// ---------------------------------------------------------------------------

enum UserRole {
  ARTIST
  MANAGER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(ARTIST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Fictional in-app points currency ($AMPS) — no real monetary value, no
  // wallet/blockchain involved. See AmpsTransaction for the append-only
  // ledger this balance is derived from.
  ampsBalance    Int      @default(0)
  unlockedThemes String[] @default([]) // keys into @amplifyworld/core's THEME_PRESETS

  accounts               Account[]
  sessions               Session[]
  pages                  Page[]
  webhookSubscriptions   WebhookSubscription[]
  integrationConnections IntegrationConnection[]
  ampsTransactions       AmpsTransaction[]
  predictionPicks        PredictionPick[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Link pages
// ---------------------------------------------------------------------------

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id        String     @id @default(cuid())
  handle    String     @unique // public URL slug, e.g. amplify.world/link/{handle}
  title     String
  bio       String?
  avatarUrl String?
  theme     Json       @default("{}") // { themeKey, layout } — validated against @amplifyworld/core's theme registry
  status    PageStatus @default(DRAFT)
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Set once an artist connects a Viberate match (onboarding wizard or the
  // "Connect Viberate" editor action) — null means not connected, and every
  // Viberate-dependent code path treats that as "nothing to do here" rather
  // than an error. See @amplifyworld/core's ArtistIntelligenceProvider.
  viberateArtistId    String?
  viberateConnectedAt DateTime?

  // Discover: primary genre/market, used for the genre x geography trending
  // view. Optional — older pages and pages never connected to Viberate may
  // not have one.
  genre   String?
  country String? // ISO country code, primary market

  // Set (with an AMPS spend) to rank/badge this page as "Boosted" in
  // Discover while in the future — see AmpsTransaction's LEADERBOARD_BOOST.
  discoverBoostedUntil DateTime?

  owner             User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks            Block[]
  subscriptions     FanSubscription[]
  analyticsEvents   AnalyticsEvent[]
  momentumScores    PageMomentumScore[]
  viberateSnapshots ViberateSnapshot[]
  momentumAlerts    MomentumAlert[]
  predictionMarket  PredictionMarket?
  passes            Pass[]

  @@index([ownerId])
  @@index([genre, country])
  @@map("pages")
}

model Block {
  id        String   @id @default(cuid())
  pageId    String
  type      String // matches a registered key in the core block registry
  position  Int      @default(0)
  isEnabled Boolean  @default(true)
  config    Json     @default("{}") // shape owned by each block's zod schema
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page            Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]

  @@index([pageId, position])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Fans
// ---------------------------------------------------------------------------

model Fan {
  id            String   @id @default(cuid())
  email         String?  @unique
  walletAddress String?  @unique // populated once linked via an IntegrationConnection (e.g. fanwallet)
  createdAt     DateTime @default(now())

  subscriptions   FanSubscription[]
  analyticsEvents AnalyticsEvent[]
  passHolders     PassHolder[]

  @@map("fans")
}

model FanSubscription {
  id           String   @id @default(cuid())
  pageId       String
  fanId        String
  subscribedAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fan  Fan  @relation(fields: [fanId], references: [id], onDelete: Cascade)

  @@unique([pageId, fanId])
  @@map("fan_subscriptions")
}

// ---------------------------------------------------------------------------
// Analytics (provider-agnostic event log; see @amplifyworld/core analytics)
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  PAGE_VIEW
  BLOCK_CLICK
  FAN_SUBSCRIBED
  CUSTOM
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  pageId     String
  blockId    String?
  fanId      String?
  metadata   Json               @default("{}")
  occurredAt DateTime           @default(now())

  // Request-derived signals, captured for PAGE_VIEW/BLOCK_CLICK on the public
  // page only (never raw IP — see apps/web request-signals service). Feed the
  // momentum scoring engine in @amplifyworld/core; nullable because older
  // rows and non-public event types don't carry them.
  country    String? // ISO country code, from edge geolocation headers
  deviceType String? // "mobile" | "desktop" | "tablet" | "other"
  source     String? // "direct" | "social" | "search" | "referral" | ...
  visitorId  String? // anonymous first-party cookie id, for unique/return-visitor detection

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  block Block? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  fan   Fan?   @relation(fields: [fanId], references: [id], onDelete: SetNull)

  @@index([pageId, occurredAt])
  @@index([pageId, visitorId])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Artist Momentum Index (daily momentum score time series per page)
// ---------------------------------------------------------------------------

model PageMomentumScore {
  id          String   @id @default(cuid())
  pageId      String
  date        DateTime @db.Date // one row per page per calendar day (UTC)
  score       Float // 0-100, see @amplifyworld/core momentum scoring engine
  scoreChange Float    @default(0) // score - previous day's score; leaderboards sort on this
  breakdown   Json     @default("{}") // per-factor sub-scores, for the "why" behind a score
  createdAt   DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@index([date, scoreChange])
  @@map("page_momentum_scores")
}

// ---------------------------------------------------------------------------
// Viberate cross-platform artist data (one daily snapshot per connected page)
// ---------------------------------------------------------------------------

model ViberateSnapshot {
  id        String   @id @default(cuid())
  pageId    String
  date      DateTime @db.Date // one row per page per calendar day (UTC), mirrors PageMomentumScore
  rankScore Float? // Viberate's own aggregate artist rank/score that day
  profile   Json     @default("{}") // the full ArtistIntelligenceSnapshot payload (genres, social links, per-platform metrics)
  fetchedAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@map("viberate_snapshots")
}

// ---------------------------------------------------------------------------
// Momentum alerts (in-app notifications — e.g. "entered the Top 100 today")
// ---------------------------------------------------------------------------

model MomentumAlert {
  id        String    @id @default(cuid())
  pageId    String
  date      DateTime  @db.Date // the day this alert fired, one per page per day
  message   String
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@map("momentum_alerts")
}

// ---------------------------------------------------------------------------
// External API keys (read-only Artist Momentum Index API — admin-issued)
// ---------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(cuid())
  label      String // e.g. "Sony Music — Q3 partnership"; who this key was issued to
  hashedKey  String    @unique // SHA-256 of the actual key — the plaintext is shown once at creation and never stored
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Feature flags (progressive rollout without redeploys)
// ---------------------------------------------------------------------------

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  description       String?
  isEnabled         Boolean  @default(false)
  rolloutPercentage Int      @default(0) // 0-100, used when isEnabled but not fully rolled out
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// External integration seams
// ---------------------------------------------------------------------------

enum IntegrationProvider {
  HEDERA
  FANWALLET
  STAKING
  CUSTOM
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  REVOKED
  ERROR
}

model IntegrationConnection {
  id         String              @id @default(cuid())
  ownerId    String
  provider   IntegrationProvider
  externalId String? // id in the external system (e.g. Hedera account id)
  config     Json                @default("{}")
  status     IntegrationStatus   @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider])
  @@map("integration_connections")
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  ownerId   String
  url       String
  secret    String // used to HMAC-sign outgoing payloads
  events    String[] // domain event names, e.g. "page.published", "fan.subscribed"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("webhook_subscriptions")
}

// ---------------------------------------------------------------------------
// $AMPS — fictional in-app points currency (no real monetary/token value)
// ---------------------------------------------------------------------------

enum AmpsTransactionType {
  SIGNUP_BONUS
  MOMENTUM_MILESTONE
  FAN_ENGAGEMENT
  PREDICTION_STAKE
  PREDICTION_PAYOUT
  LEADERBOARD_BOOST
  THEME_UNLOCK
}

model AmpsTransaction {
  id           String              @id @default(cuid())
  userId       String
  type         AmpsTransactionType
  amount       Int // signed: positive = earn, negative = spend
  balanceAfter Int
  description  String
  metadata     Json                @default("{}")
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("amps_transactions")
}

// ---------------------------------------------------------------------------
// Prediction markets — fictional, playful "who will break out" points game.
// Demo picks resolve instantly against the market's stated odds (no shared
// future event to wait for) — never real money, never a real gambling product.
// ---------------------------------------------------------------------------

model PredictionMarket {
  id        String   @id @default(cuid())
  pageId    String   @unique // the fictional "up-and-coming" artist being predicted on
  question  String
  odds      Float // consensus probability, 0-1 — each pick resolves instantly against this
  closesAt  DateTime // cosmetic — this demo has no shared future event to wait for
  createdAt DateTime @default(now())

  page  Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  picks PredictionPick[]

  @@map("prediction_markets")
}

model PredictionPick {
  id          String   @id @default(cuid())
  marketId    String
  userId      String
  stakeAmount Int
  hit         Boolean // resolved instantly on creation, never left pending
  payout      Int // 0 on a miss
  createdAt   DateTime @default(now())

  market PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([userId])
  @@map("prediction_picks")
}

// ---------------------------------------------------------------------------
// Passes — demo-only, fanwallet-UX-inspired fan passes (branded card + QR +
// a mocked "Add to Wallet"). Entirely local/fictional: no real dependency on
// or import from fanwallet (a separate product/repo) — see IntegrationConnection's
// `FANWALLET` provider value for how this app already keeps that boundary.
// ---------------------------------------------------------------------------

model Pass {
  id          String    @id @default(cuid())
  pageId      String
  name        String
  accentColor String    @default("#ff4081")
  imageUrl    String?
  eventName   String?
  eventDate   DateTime?
  eventVenue  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  page    Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  holders PassHolder[]

  @@index([pageId])
  @@map("passes")
}

model PassHolder {
  id          String    @id @default(cuid())
  passId      String
  fanId       String
  claimedAt   DateTime  @default(now())
  checkedInAt DateTime?

  pass Pass @relation(fields: [passId], references: [id], onDelete: Cascade)
  fan  Fan  @relation(fields: [fanId], references: [id], onDelete: Cascade)

  @@unique([passId, fanId])
  @@map("pass_holders")
}
